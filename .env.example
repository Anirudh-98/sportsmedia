# ==========================================
# SPORTSMEDIA - ENVIRONMENT CONFIGURATION
# ==========================================

# Database
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
DATABASE_URL="mysql://sportsuser:ChangeMePassword@localhost:3306/sportsmedia_db"

# Authentication (JWT)
# Generate a strong 64-character secret for production: openssl rand -base64 32
JWT_SECRET="sportsmedia-jwt-secret-replace-with-secure-random-key-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Public Application URL
NEXT_PUBLIC_APP_URL="https://sportsmedia.world"

# Firebase Client Configuration
# Copy this file to .env.local and fill in your actual Firebase values.
# NEVER commit real API keys to GitHub or public repositories.
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key-here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your-measurement-id"
