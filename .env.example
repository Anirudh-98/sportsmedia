# ==========================================
# SPORTSMEDIA - ENVIRONMENT CONFIGURATION
# Vercel + Hostinger Architecture
# ==========================================

# Database (Hostinger MySQL)
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
DATABASE_URL="mysql://sportsuser:ChangeMePassword@hostinger-mysql-host.com:3306/sportsmedia_db"

# Authentication (Custom JWT)
# Generate a strong 64-character secret for production: openssl rand -base64 32
JWT_SECRET="sportsmedia-jwt-secret-replace-with-secure-random-key-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Hostinger File Storage (SFTP/FTP or CDN API)
HOSTINGER_STORAGE_PUBLIC_URL="https://storage.sportsmedia.world"
HOSTINGER_STORAGE_HOST="ftp.sportsmedia.world"
HOSTINGER_STORAGE_USERNAME="u123456789"
HOSTINGER_STORAGE_PASSWORD="StoragePasswordHere"
HOSTINGER_STORAGE_PATH="/public_html/uploads"

# Public Application URL
NEXT_PUBLIC_APP_URL="https://sportsmedia.world"
