rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS & ROLE VERIFICATION
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : (getUserData() != null ? getUserData().role : '');
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "admin@sportsmedia.world" ||
        getUserRole() == "admin" ||
        (getUserData() != null && getUserData().email == "admin@sportsmedia.world")
      );
    }

    function isStudent() {
      return isAuthenticated() && (getUserRole() == "student" || getUserRole() == "journalist");
    }

    function isCoach() {
      return isAuthenticated() && getUserRole() == "coach";
    }

    function isSchool() {
      return isAuthenticated() && getUserRole() == "school";
    }

    function isSponsor() {
      return isAuthenticated() && getUserRole() == "sponsor";
    }

    // ==========================================
    // 1. USERS & PROFILES
    // - Read: Public/Authenticated can read profiles
    // - Write/Create: Any new user can register
    // - Update: User can update own profile, Admin can update any
    // - Delete: Admin only
    // ==========================================
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 2. JOURNALISM COURSES
    // - Read: Student, Public, Admin
    // - Write/Create, Update, Delete: Admin only
    // ==========================================
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 3. JOURNALISM ASSIGNMENTS
    // - Read: Student (own), Admin (all)
    // - Write/Create: Student (submit), Admin
    // - Update: Student (own pending), Admin (grade & feedback)
    // - Delete: Admin only
    // ==========================================
    match /assignments/{assignmentId} {
      allow read: if isStudent() || isAdmin();
      allow create: if isStudent() || isAdmin();
      allow update: if (isStudent() && (resource.data.studentId == request.auth.uid || resource.data.studentEmail == request.auth.token.email)) || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 4. ARTICLES & STORIES
    // - Read: Public (published), Student (own drafts), School (own), Admin (all)
    // - Write/Create: Student, School, Admin
    // - Update: Student (own draft), School (own draft), Admin (approve/edit/publish)
    // - Delete: Admin only
    // ==========================================
    match /articles/{articleId} {
      allow read: if resource.data.status == 'published' || 
                     (isStudent() && resource.data.authorId == request.auth.uid) || 
                     (isSchool() && resource.data.schoolId == request.auth.uid) || 
                     isAdmin();
      allow create: if isStudent() || isSchool() || isAdmin();
      allow update: if (isStudent() && resource.data.authorId == request.auth.uid && resource.data.status != 'published') || 
                     (isSchool() && resource.data.schoolId == request.auth.uid && resource.data.status != 'published') || 
                     isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 5. ATHLETES & PERFORMANCE
    // - Read: Public directory, Coach, School, Sponsor, Student, Admin
    // - Write/Create: Coach (enrolled athletes), School, Admin
    // - Update: Coach (performance & stats), School, Admin
    // - Delete: Admin only
    // ==========================================
    match /athletes/{athleteId} {
      allow read: if true;
      allow create: if isCoach() || isSchool() || isAdmin();
      allow update: if isCoach() || isSchool() || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 6. EVENTS & COMPETITIONS
    // - Read: Public, Student, Sponsor, Coach, School, Admin
    // - Write/Create: Coach, School, Admin
    // - Update: Coach, School, Admin
    // - Delete: Admin only
    // ==========================================
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isCoach() || isSchool() || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 7. ACHIEVEMENTS & RECORDS
    // - Read: Public, Student, Sponsor, Coach, School, Admin
    // - Write/Create: Coach, School, Admin
    // - Update: Coach, School, Admin
    // - Delete: Admin only
    // ==========================================
    match /achievements/{achievementId} {
      allow read: if true;
      allow create, update: if isCoach() || isSchool() || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 8. MEDIA UPLOADS
    // - Read: Public, all roles
    // - Write/Create: Student (portfolio), Coach (proof), School (events), Admin
    // - Update: Owner of media, Admin
    // - Delete: Admin only
    // ==========================================
    match /media/{mediaId} {
      allow read: if true;
      allow create: if isStudent() || isCoach() || isSchool() || isAdmin();
      allow update: if (isAuthenticated() && resource.data.uploadedBy == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 9. SCHOOLS
    // - Read: Public, all roles
    // - Write/Create: School, Admin
    // - Update: School (own profile), Admin
    // - Delete: Admin only
    // ==========================================
    match /schools/{schoolId} {
      allow read: if true;
      allow create: if isSchool() || isAdmin();
      allow update: if (isSchool() && (schoolId == request.auth.uid || resource.data.adminUid == request.auth.uid)) || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 10. SPONSORSHIPS & PROGRAMS
    // - Read: Public, Sponsor, Admin, all roles
    // - Write/Create: Sponsor (pledge/fund), Admin
    // - Update: Sponsor (own sponsorship allocation), Admin
    // - Delete: Admin only
    // ==========================================
    match /sponsorships/{sponsorshipId} {
      allow read: if true;
      allow create: if isSponsor() || isAdmin();
      allow update: if (isSponsor() && (resource.data.sponsorId == request.auth.uid || resource.data.sponsorEmail == request.auth.token.email)) || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 11. APPROVALS & MODERATION QUEUE
    // - Read: Admin only
    // - Write/Create: Anyone (registration, submissions)
    // - Update: Admin only (approve / reject / request changes)
    // - Delete: Admin only
    // ==========================================
    match /approvals/{approvalId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // DEFAULT CATCH-ALL
    // ==========================================
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
