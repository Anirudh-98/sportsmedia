rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@sportsmedia.world' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Users Collection: User accounts and role-based profiles
    match /users/{userId} {
      // Anyone can read profile details (needed for public athlete/coach/author directory)
      allow read: if true;
      
      // Users can register their own profile, or admins can create users
      allow create: if isAuthenticated() || (
        request.resource.data.email is string &&
        request.resource.data.name is string &&
        request.resource.data.role in ['student', 'coach', 'school', 'sponsor', 'admin']
      );
      
      // Users can update their own profile; admins can update any profile (e.g. approve/suspend)
      allow update: if isOwner(userId) || isAdmin() || (
        isAuthenticated() && request.resource.data.email == resource.data.email
      );
      
      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }

    // 2. Articles Collection: Sports journalism articles & student news
    match /articles/{articleId} {
      allow read: if true;
      allow create: if isAuthenticated() || request.resource.data.title is string;
      allow update, delete: if isAuthenticated();
    }

    // 3. Athletes / Coach Athletes: Roster & performance records
    match /athletes/{athleteId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /coach_athletes/{athleteId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 4. Events: Grassroots sporting competitions & trials
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 5. Sponsorships & Programs: CSR & talent funding grants
    match /sponsorships/{sponsorshipId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /sponsorship_programs/{programId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 6. Media Uploads: Match footage, photos, certificates
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 7. Approvals: Moderation queue for admin review
    match /approvals/{approvalId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 8. Courses & Assignments: Journalism training school
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 9. Schools: Institution sport profiles
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Global fallback for any other collections
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
